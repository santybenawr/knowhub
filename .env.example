# ---------------------------------------------------------------------------
# KnowHub environment
#
# Every value here is optional. With an empty file KnowHub boots against an
# embedded PostgreSQL (PGlite + pgvector), local private file storage and the
# deterministic local AI providers — a fully working app with no external
# services. Fill these in to move each piece to a real provider.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3010

# --- Database --------------------------------------------------------------
# Unset  -> embedded PGlite at PGLITE_DATA_DIR (development, tests, CI).
# Set    -> any PostgreSQL 15+ with the `vector` extension available.
# DATABASE_URL=postgresql://user:password@host:5432/knowhub
PGLITE_DATA_DIR=.data/pglite

# --- Auth ------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -base64 48
# AUTH_SECRET=
AUTH_PROVIDER=local

# --- Storage ---------------------------------------------------------------
# `local` keeps files outside public/ and serves them through signed URLs.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/storage

# --- Supabase (optional) ---------------------------------------------------
# Used when STORAGE_PROVIDER=supabase. The bucket MUST be private.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=knowhub-private

# --- AI --------------------------------------------------------------------
# Unset OPENAI_API_KEY -> local deterministic provider (development only;
# production requires either a key or an explicit AI_PROVIDER=mock).
# AI_PROVIDER=openai
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Changing this requires a migration and re-embedding all content.
EMBEDDING_DIMENSIONS=1536

# --- Transcription ---------------------------------------------------------
# Falls back to OPENAI_API_KEY when TRANSCRIPTION_API_KEY is not set.
# TRANSCRIPTION_PROVIDER=openai
# TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# --- Limits ----------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_AUDIO_UPLOAD_MB=200
MAX_MEETING_DURATION_MINUTES=240
# Scales every rate limit. Raise only for load tests or an E2E suite driving the
# app from a single IP. Keep at 1 in production.
RATE_LIMIT_MULTIPLIER=1

# --- Billing (optional; the app works without it) --------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Observability (optional) ----------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Demo data -------------------------------------------------------------
# `true` lets `pnpm db:seed` create the demo workspace. Never set in production.
ENABLE_DEMO_DATA=false
